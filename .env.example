# Copy to .env for local use. Never commit .env.

PORT=3000
HOST=0.0.0.0

# First-run teacher sign-up code (6+ characters). After the first start it
# lives in the database and can be changed from the admin dashboard.
TEACHER_SIGNUP_CODE=

# --- Database ---
# Leave both empty to use a local SQLite file (server/data/assessment.db).
# For hosted data (needed on hosts with a wiped filesystem, e.g. Render free):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional
GOOGLE_CLIENT_ID=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
